{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    //"DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=RoyalStore;Trusted_Connection=True;TrustServerCertificate=True;",
    "DefaultConnection": "Server=127.0.0.1\\SQLEXPRESS;Database=RoyalStore;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_STRONG_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "royal-store-api",
    "Audience": "royal-store-client",
    "ExpiryMinutes": 60
  },
  "PasswordReset": {
    "ClientAppBaseUrl": "REPLACE_WITH_FRONTEND_BASE_URL",
    "TokenExpiryMinutes": 60,
    "MaxAttemptsPerWindow": 3,
    "WindowMinutes": 60
  },
  "ResendConfirmation": {
    "CooldownSeconds": 60,
    "MaxAttemptsPerWindow": 5,
    "WindowHours": 24,
    "IpPermitLimit": 20,
    "IpWindowMinutes": 1
  },
  "ChangePendingEmail": {
    "MaxFailedAttemptsPerWindow": 5,
    "FailedAttemptsWindowMinutes": 15,
    "CooldownSeconds": 60,
    "MaxSuccessfulChangesPerWindow": 5,
    "SuccessfulChangesWindowHours": 24,
    "IpPermitLimit": 20,
    "IpWindowMinutes": 1
  }
}
